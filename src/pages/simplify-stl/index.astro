---
/**
 * Secondary SEO route for the same optimization engine
 * `/reduce-stl-file-size/` uses. Self-canonicalizes (matching the Phase
 * 5/6 precedent) since its copy below targets a genuinely distinct
 * intent — "simplify a mesh" (a modeling/detail-reduction framing), not
 * "shrink a file" (a storage/transfer framing). The interactive tool is
 * never duplicated: this page's script tag imports the exact same
 * `../reduce-stl-file-size/_client` module.
 */
import ToolLayout from "../../layouts/ToolLayout.astro";
import PrivacyNotice from "../../components/tools/PrivacyNotice.astro";
import LocalFilePicker from "../../components/tools/LocalFilePicker.astro";
import ToolStatus from "../../components/tools/ToolStatus.astro";
import ToolViewport from "../../components/tools/ToolViewport.astro";
import ToolError from "../../components/tools/ToolError.astro";
import STLOptimizeSettings from "../../components/tools/STLOptimizeSettings.astro";
import STLOptimizePlan from "../../components/tools/STLOptimizePlan.astro";
import STLOptimizeResult from "../../components/tools/STLOptimizeResult.astro";
import STLOptimizeComparison from "../../components/tools/STLOptimizeComparison.astro";
import STLOptimizeControls from "../../components/tools/STLOptimizeControls.astro";
import BatchPlanWorkspace from "../../components/tools/BatchPlanWorkspace.astro";
import BatchOptimizeSettings from "../../components/tools/BatchOptimizeSettings.astro";
import RelatedTools from "../../components/tools/RelatedTools.astro";
import { getToolById } from "../../config/tools";

const tool = getToolById("simplify-stl")!;
const relatedTools = (tool.relatedToolIds ?? []).map((id) => getToolById(id));

const breadcrumbs = [
  { name: "Home", path: "/" },
  { name: "Simplify STL", path: "/simplify-stl/" },
];

const faqs = [
  {
    question: "What does \"simplify\" mean for a 3D mesh?",
    answer:
      "Reducing the number of triangles used to represent the same overall shape, via edge-collapse simplification — merging pairs of nearby vertices in the order that changes the surface least, measured by quadric error metrics.",
  },
  {
    question: "Will simplifying round off my model's sharp corners?",
    answer:
      "Not under the \"Preserve details\" preset — its tighter normal-flip and deviation limits keep genuinely sharp features intact at the cost of a more modest reduction. \"Maximum reduction\" trades more detail for a smaller mesh, but never breaks the mesh's manifold topology to do it.",
  },
  {
    question: "Can I choose exactly how simplified the result is?",
    answer:
      "Yes — pick 25/50/75% fewer triangles, or type an exact target triangle count. The resolved target (after any safety-floor clamping) is always shown before you run anything.",
  },
  {
    question: "Does simplifying preserve multiple separate parts in one file?",
    answer:
      "Yes. Shell count is preserved by default — this tool never merges or deletes an entire disconnected shell, even a very small one, as a side effect of simplifying the others.",
  },
  {
    question: "Is my mesh uploaded anywhere to simplify it?",
    answer:
      "No. The entire simplification pipeline — analysis, the collapse loop, serialization and verification — runs locally in a Web Worker in your browser.",
  },
];
---

<ToolLayout
  title="Simplify STL Mesh — Reduce Triangle Count Online | MeshWrench"
  description="Simplify an STL mesh with topology-safe edge-collapse reduction — preserves boundaries and shells, verified against the real output. Free, local."
  path="/simplify-stl/"
  h1="Simplify STL"
  intro="Reduce a mesh's triangle count while keeping its overall shape, boundary loops and shell structure intact — deterministic edge-collapse simplification, verified against the actual generated output."
  breadcrumbs={breadcrumbs}
  faqs={faqs}
  webApplication={{
    name: "MeshWrench Simplify STL",
    applicationCategory: "UtilitiesApplication",
    description:
      "Simplify an STL mesh's triangle count locally in the browser with quadric-error-metric edge-collapse reduction, preserving manifold topology, boundary loops and shell structure, verified against the actual serialized output. No upload, no account required.",
    offers: [{ price: "0", priceCurrency: "USD", category: "Free browser tool" }],
  }}
>
  <PrivacyNotice slot="privacy-notice" message="Your STL stays on this device. MeshWrench simplifies it locally in your browser." />

  <div slot="file-input">
    <LocalFilePicker
      id="stl-file-input"
      label="Select an STL file to simplify"
      accept=".stl,model/stl,application/sla,application/vnd.ms-pki.stl,application/octet-stream"
      helpText="Binary or ASCII STL, up to 150 MB. This limit protects your browser from freezing — it isn't a Pro restriction."
    />
  </div>

  <div slot="status" class="stl-status-row">
    <ToolStatus id="stl-status" />
    <button type="button" class="control-button" data-action="cancel" hidden>Cancel</button>
  </div>

  <div slot="workspace" class="stl-workspace-grid">
    <ToolViewport id="stl-optimize-viewport" description="Interactive 3D preview of the original and simplified model. Drag to rotate, scroll to zoom." />
    <STLOptimizeControls id="stl-optimize-controls" />
  </div>

  <div slot="results">
    <p class="success-confirmation" data-success-confirmation hidden>
      <span aria-hidden="true">✓</span> Processed locally — nothing was uploaded.
    </p>
    <STLOptimizeSettings id="stl-optimize-settings" />
    <STLOptimizePlan id="stl-optimize-plan" />
    <STLOptimizeResult id="stl-optimize-result" />
    <STLOptimizeComparison id="stl-optimize-comparison" />
    <ToolError id="stl-optimize-error" />

    <BatchPlanWorkspace id="simplify-stl-batch-workspace" acceptHint="STL files only, same limits as single-file optimization.">
      <BatchOptimizeSettings slot="settings" />
    </BatchPlanWorkspace>
  </div>

  <Fragment slot="seo-content">
    <h2>Steps to simplify a mesh</h2>
    <ol>
      <li>Select your STL file — MeshWrench checks it locally and shows whether it's eligible for simplification.</li>
      <li>Pick a quality preset (Preserve details, Balanced, or Maximum reduction) and a target reduction.</li>
      <li>Review the plan, run the simplification, and inspect the verified before/after comparison.</li>
      <li>Download the simplified STL and/or a JSON report with the full verification details.</li>
    </ol>

    <h2>Sharp features vs. maximum reduction</h2>
    <p>
      Each quality preset resolves to a different maximum normal-flip angle and sampled-deviation ceiling — the
      exact numeric policy behind "Preserve details," "Balanced," and "Maximum reduction." None of the three presets
      ever disable the underlying topology-safety checks (the manifold link condition, boundary-loop adjacency,
      shell-membership and degenerate/duplicate-triangle guards) — a preset only ever changes how much visual detail
      is traded for a smaller mesh, never whether the result stays a valid, manifold-safe mesh.
    </p>

    <h2>What simplification preserves by default</h2>
    <ul>
      <li><strong>Manifold topology</strong> — a watertight input stays watertight in the verified output.</li>
      <li><strong>Boundary loops</strong> — an open mesh's boundary edges are never merged into the interior or turned into a new hole.</li>
      <li><strong>Shell count</strong> — every separate disconnected part in the file stays present.</li>
    </ul>

    <h2>What this tool cannot safely do</h2>
    <ul>
      <li>It never simplifies non-manifold topology by default — you're directed to <a href="/stl-repair/">STL Repair</a> first.</li>
      <li>It cannot guarantee an exact requested triangle count — an unachievable target stops at the best safe reduction, reported honestly.</li>
      <li>It cannot guarantee printability, wall thickness, or fitness for any specific printer.</li>
    </ul>
  </Fragment>

  <Fragment slot="faqs">
    <section class="faq-section-tool">
      <h2>Frequently asked questions</h2>
      <div class="faq-list-tool">
        {faqs.map((faq) => (
          <details>
            <summary>{faq.question}</summary>
            <p>{faq.answer}</p>
          </details>
        ))}
      </div>
    </section>
  </Fragment>

  <RelatedTools slot="related-tools" relatedTools={relatedTools} note={`Simplifying many files? Try the Batch tab above — batch optimization is a <a href="/pricing/">Pro</a> capability.`} />
</ToolLayout>

<script>
  import "../reduce-stl-file-size/_client";
</script>

<style>
  .faq-section-tool {
    margin-top: 20px;
  }
  .faq-list-tool {
    border-top: 1px solid var(--line);
  }
  .faq-list-tool details {
    border-bottom: 1px solid var(--line);
    padding: 14px 0;
  }
  .faq-list-tool summary {
    cursor: pointer;
    font-weight: 700;
  }
  .faq-list-tool p {
    margin: 10px 0 0;
    color: var(--muted);
  }
  .pro-transition-note {
    margin-top: 12px;
    color: var(--muted);
    font-size: 0.85rem;
    font-style: italic;
  }
</style>
