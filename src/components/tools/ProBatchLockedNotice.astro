---
/**
 * The thing a Free user sees in the Batch tab — the highest-intent
 * upsell moment in the whole product (someone who just tried to batch
 * process). Links to the real, live checkout/activation page.
 */
import { siteConfig } from "../../config/site";

interface Props {
  id: string;
}
const { id } = Astro.props;
---

<div id={id} class="pro-locked-notice" data-pro-locked-notice role="status">
  <p class="pro-locked-headline">Batch processing is a Pro capability.</p>
  <p>
    Get <a href="/pricing/">{siteConfig.productName} Pro</a> to batch this whole folder at once — a one-time ${siteConfig.proPriceUsd} payment, never a subscription.
    Already own Pro? <a href="/pricing/#activate">Activate your license key</a>.
  </p>
</div>

<style>
  .pro-locked-notice {
    padding: 18px 20px;
    border-radius: 12px;
    border: 1px dashed var(--line);
    background: var(--panel);
    color: var(--muted);
  }
  .pro-locked-headline {
    margin: 0 0 6px;
    font-weight: 700;
    color: var(--ink);
  }
  .pro-locked-notice p {
    margin: 0;
  }
  .pro-locked-notice p + p {
    margin-top: 6px;
  }
</style>
