---
/**
 * Presentation only — a before/after numeric comparison table.
 * `_client.ts` fills every `data-*` node. The 3D viewport itself is
 * shared (a single `ToolViewport`, toggled between original and
 * repaired geometry via `STLRepairControls`'s own toggle button) rather
 * than two independent side-by-side viewports — see this project's own
 * disclosed scope note on true side-by-side rendering in
 * `docs/ARCHITECTURE.md`'s "STL Repair (Phase 6)" section.
 */
interface Props {
  id?: string;
}

const { id = "stl-repair-comparison" } = Astro.props;
---

<section class="repair-comparison" id={id} data-repair-comparison hidden aria-label="Before and after comparison">
  <h3>Before / after</h3>
  <table class="comparison-table">
    <thead>
      <tr><th scope="col">Measure</th><th scope="col">Before</th><th scope="col">After</th></tr>
    </thead>
    <tbody>
      <tr><th scope="row">Watertight verdict</th><td data-compare-verdict-before></td><td data-compare-verdict-after></td></tr>
      <tr><th scope="row">Triangles</th><td data-compare-triangles-before></td><td data-compare-triangles-after></td></tr>
      <tr><th scope="row">Unique vertices</th><td data-compare-vertices-before></td><td data-compare-vertices-after></td></tr>
      <tr><th scope="row">Shells</th><td data-compare-shells-before></td><td data-compare-shells-after></td></tr>
      <tr><th scope="row">Boundary edges</th><td data-compare-boundary-before></td><td data-compare-boundary-after></td></tr>
      <tr><th scope="row">Non-manifold edges</th><td data-compare-nonmanifold-before></td><td data-compare-nonmanifold-after></td></tr>
      <tr><th scope="row">Winding conflicts</th><td data-compare-winding-before></td><td data-compare-winding-after></td></tr>
      <tr><th scope="row">Self-intersections</th><td data-compare-selfintersect-before></td><td data-compare-selfintersect-after></td></tr>
    </tbody>
  </table>
</section>
