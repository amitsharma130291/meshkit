---
/**
 * Presentation shell only. Reuses GLBMaterialInfo.astro's own class names
 * (`glb-material-*`) — already generic enough (swatch/name/meta/card) to
 * cover FBX's own smaller Lambert/Phong material subset without a new
 * stylesheet block.
 */
interface Props {
  id?: string;
}

const { id = "fbx-material-info" } = Astro.props;
---

<section class="glb-material-panel" id={id} data-material-panel hidden aria-label="Materials">
  <h2>Materials</h2>
  <div class="glb-material-list" data-material-list></div>
  <p class="glb-material-empty" data-material-empty hidden>This file doesn't declare any materials.</p>
</section>
