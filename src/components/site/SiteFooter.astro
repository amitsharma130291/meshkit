---
import { siteConfig } from "../../config/site";
const year = new Date().getFullYear();
---

<footer class="site-footer section-shell">
  <div>
    <a class="brand footer-brand" href="/#top">
      <img class="brand-logo" src="/meshwrench-logo-horizontal.png" width="1600" height="366" alt={siteConfig.productName} loading="lazy" />
    </a>
    <p>Private browser-based tools for 3D files.</p>
  </div>
  <nav aria-label="Footer navigation">
    <a href="/#popular-tools">Tools</a>
    <a href="/#privacy">Privacy</a>
    <a href="/#pro">Pro</a>
    <a href="/#faq">FAQ</a>
  </nav>
  <div class="footer-meta">
    <span>Files stay on your device.</span>
    <span>© {year} {siteConfig.productName}</span>
  </div>
</footer>
