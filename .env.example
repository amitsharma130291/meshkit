# Phase 11 — Dodo Payments checkout + license-key email flow.
# Copy this file to `.env` for local `astro dev`, and set the same
# variables in the Vercel project's Environment Variables settings for
# the deployed site. Never commit a real `.env` file (see .gitignore).

# --- Dodo Payments (test mode) ---------------------------------------
# From the Dodo dashboard, Developer -> API Keys (test mode).
DODO_PAYMENTS_API_KEY=
# From Developer -> Webhooks -> your endpoint's signing secret, once
# you've added https://<your-deployment>/api/webhooks/dodo as an
# endpoint subscribed to at least: payment.succeeded, payment.failed,
# license_key.created.
DODO_PAYMENTS_WEBHOOK_KEY=
# "test_mode" while testing; "live_mode" only once you intentionally
# switch to real payments.
DODO_PAYMENTS_ENVIRONMENT=test_mode
# The product id (pdt_...) of the $39 Pro product, which must have a
# License Key entitlement attached (Entitlements -> New -> License Key,
# then attach it to the product under Advanced Settings). See
# docs/ARCHITECTURE.md's Phase 11 section for the exact dashboard steps.
DODO_PAYMENTS_PRODUCT_ID=

# --- License/email storage (Upstash Redis via Vercel Marketplace) ----
# Vercel project -> Storage -> add a Redis (Upstash) integration, then
# copy its REST URL/token here (or let Vercel inject them automatically
# once the integration is connected — these names match what Vercel sets).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Outbound email (Gmail SMTP) --------------------------------------
GMAIL_SMTP_USER=amitsharma00261@gmail.com
# A Google Account "App Password" (Google Account -> Security -> 2-Step
# Verification -> App passwords) — NOT the real account password.
GMAIL_SMTP_APP_PASSWORD=

# Where the "payment succeeded/failed — full payload" admin emails go.
ADMIN_NOTIFICATION_EMAIL=amitsharma00261@gmail.com
